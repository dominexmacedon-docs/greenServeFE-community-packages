{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MacoraOne/greenServeFE-community-packages/main/registry/package.schema.json",
  "title": "greenServeFE Community Module Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "author",
    "license",
    "greenServeFE",
    "platforms"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "greenServeFE": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      }
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
